# HTTP port the app listens on (0.0.0.0). Default 7474.
PORT=
# Directory for the local bun:sqlite file (cryer.db) when RQLITE_URLS is unset. Default ./data.
DATA_DIR=
# Comma-separated rqlite HTTP endpoints (http://host:4001,...). Set → rqlite store; unset → bun:sqlite.
RQLITE_URLS=
# Discord bot token (Developer Portal → Bot).
DISCORD_TOKEN=
# Discord application id (snowflake).
DISCORD_APP_ID=
# Discord application public key (hex) used to verify /interactions signatures.
DISCORD_PUBLIC_KEY=
# Bearer token required on the API, MCP and ingest endpoints.
CRYER_API_TOKEN=
# opencode server for the opencode-session callback (e.g. http://192.168.1.10:4096). Unset → that callback is disabled.
OPENCODE_URL=
# Basic-auth username for OPENCODE_URL. Default opencode.
OPENCODE_SERVER_USERNAME=
# Basic-auth password for OPENCODE_URL.
OPENCODE_SERVER_PASSWORD=
# Channel id used when the settings table is unreachable or has no default_channel yet.
# Also accepts dm:<user_id> to deliver to a user's DM instead of a channel.
DEFAULT_CHANNEL_ID=
# Bootstrap log level (debug|info|warn|error); the log_level setting overrides it at runtime.
LOG_LEVEL=
# Name of this replica, used as the gateway lease holder. Default: hostname.
CRYER_NODE=
# Version reported by /health. Default: the package.json version.
CRYER_VERSION=
# Optional: path to a private CA (PEM) if your callback or ingest targets use one (mount it into the container).
NODE_EXTRA_CA_CERTS=
