# The app's secrets on a replica node: ./.env next to compose.yaml (0600), bind-mounted read-only at /app/.env.
PORT=7474
# rqlite voters, comma-separated; the app fails over client-side. Leave empty for a single replica on bun:sqlite
# (then mount a volume at /app/data).
RQLITE_URLS=http://192.168.1.10:4001,http://192.168.1.11:4001,http://192.168.1.12:4001
LOG_LEVEL=info

# Discord application (Developer Portal → your app → Bot / General Information)
DISCORD_TOKEN=replace_me
DISCORD_APP_ID=replace_me
DISCORD_PUBLIC_KEY=replace_me
# channel of your server that receives notifications with no routing match
DEFAULT_CHANNEL_ID=replace_me

# API / MCP / ingest bearer (same value in every client: MCP config, bin/cryer, apprise/dagu targets)
CRYER_API_TOKEN=replace_me

# opencode session callback (the `opencode-session` callback kind); leave empty if you do not use it
OPENCODE_URL=
OPENCODE_SERVER_PASSWORD=

# Replica name used as the gateway lease holder (default: the container hostname)
CRYER_NODE=node-a
