# ./.env on each voter — nothing secret here.
RQLITE_NODE_ID=node-a
RQLITE_ADV_IP=192.168.1.10
# Raft addresses (port 4002) of all voters, same value on every node or the cluster will not form
RQLITE_JOIN=192.168.1.10:4002,192.168.1.11:4002,192.168.1.12:4002
# Optional overrides (same value on every node):
#RQLITE_TAG=10.5.3
#RQLITE_BOOTSTRAP_EXPECT=3
